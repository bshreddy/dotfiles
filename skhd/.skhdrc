# Yabai Space Management
alt - 1 : yabai -m space --focus s1
alt - 2 : yabai -m space --focus s2
alt - 3 : yabai -m space --focus s3
alt - 4 : yabai -m space --focus s4
alt - 5 : yabai -m space --focus s5
alt - 6 : yabai -m space --focus s6
alt - 7 : yabai -m space --focus s7
alt - 8 : yabai -m space --focus s8
alt - 9 : yabai -m space --focus s9
alt - 0 : yabai -m space --focus "d$(yabai -m query --displays --display | jq .index)"

# alt - [
alt - 0x21 : yabai -m space --focus prev || yabai -m space --focus last
# alt - ]
alt - 0x1E : yabai -m space --focus next || yabai -m space --focus first

alt - z : yabai -m space --balance
alt - q : yabai -m space --rotate 90
alt - e : yabai -m space --rotate 270

# Yabai Window Management
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

alt - f : yabai -m window --toggle zoom-fullscreen

alt + shift - 1 : yabai -m window --space s1 && yabai -m space --focus s1
alt + shift - 2 : yabai -m window --space s2 && yabai -m space --focus s2
alt + shift - 3 : yabai -m window --space s3 && yabai -m space --focus s3
alt + shift - 4 : yabai -m window --space s4 && yabai -m space --focus s4
alt + shift - 5 : yabai -m window --space s5 && yabai -m space --focus s5
alt + shift - 6 : yabai -m window --space s6 && yabai -m space --focus s6
alt + shift - 7 : yabai -m window --space s7 && yabai -m space --focus s7
alt + shift - 8 : yabai -m window --space s8 && yabai -m space --focus s8
alt + shift - 9 : yabai -m window --space s9 && yabai -m space --focus s9
alt + shift - 0 : yabai -m window --space "d$(yabai -m query --displays --display | jq .index)" && yabai -m space --focus "d$(yabai -m query --displays --display | jq .index)"

# alt - `
alt - 0x32 : yabai -m space --display next || yabai -m space --display first

# alt - [
alt + shift - 0x21 : yabai -m window --focus prev || yabai -m window --focus last
# alt - ]
alt + shift - 0x1E : yabai -m window --focus next || yabai -m window --focus first
